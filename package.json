{
	"name": "projects",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/check-lfs.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:seo": "python3 scripts/seo-check.py",
		"test:seo:unit": "python3 -B scripts/test_seo_check.py",
		"images": "node scripts/process-images.mjs",
		"images:force": "node scripts/process-images.mjs --force"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^25.6.0",
		"daisyui": "^5.5.19",
		"sharp": "^0.34.5",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@types/nodemailer": "^8.0.0",
		"nodemailer": "^8.0.7"
	}
}
